# DayOne AI Backend — Environment Configuration Template
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to git — only this `.env.example` file should be committed.

# --- Application ---
APP_NAME=DayOne AI Backend
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# --- Google Cloud Project & Region ---
# Your GCP Project ID (find it in the GCP Console top-left dropdown)
GCP_PROJECT_ID=your-gcp-project-id
# Region where your Cloud Run, Firestore, and Cloud Storage are deployed
GCP_LOCATION=asia-southeast1

# --- AI Models (Vertex AI) ---
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# --- Firestore ---
# The Database ID you created in the Firestore Console
FIRESTORE_DATABASE=hris-firestore

# --- Cloud Storage ---
# The bucket name you created for storing uploaded PDF documents
GCS_BUCKET_NAME=your-dayone-documents-bucket

# --- Access control ---
# Comma-separated user IDs with HR admin rights. Decided on the server; the
# X-Access-Level request header cannot grant it.
HR_ADMIN_USER_IDS=hr_admin_001

# --- Chat ---
# Classify each chat message with one short Gemini call (falls back to regex rules
# on error or timeout). INTENT_MODEL defaults to GEMINI_MODEL when empty.
INTENT_CLASSIFIER_ENABLED=true
INTENT_MODEL=
INTENT_TIMEOUT_SECONDS=4
# Raw, ungrounded Gemini access on /chat (system_instruction, model, stream, ...).
# Keep false in production. When true, only HR admins may use it.
ENABLE_RAW_GEMINI_BRIDGE=false

# --- Local Fallback Storage ---
# Used automatically when GCS_BUCKET_NAME is empty (local development only)
LOCAL_STORAGE_DIR=./data/storage

# --- Authentication (optional) ---
# Path to a Service Account JSON key file.
# Leave empty to use Application Default Credentials (ADC) via `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=
