# DayOne AI Backend — Environment Configuration (template)
# Copy this file to `.env` and fill in real values. Never commit real secrets.

# --- Application ---
APP_NAME=DayOne AI Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# --- Google Cloud project & region (Vertex AI, Firestore, Cloud Storage) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# --- Models ---
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# --- Cloud Storage bucket for original PDFs ---
GCS_BUCKET_NAME=your-dayone-documents-bucket

# --- Firestore database ("(default)" unless you created a named database) ---
FIRESTORE_DATABASE=(default)

# --- Optional: path to a Service Account JSON key. If empty, ADC is used. ---
GOOGLE_APPLICATION_CREDENTIALS=

# --- Local fallback storage directory (used when GCS_BUCKET_NAME is unset) ---
LOCAL_STORAGE_DIR=./data/storage


